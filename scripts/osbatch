#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from daemon.oslurmd.store import JobStore
from oslurm.slurm_bridge import SlurmBridge


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("workload")
    parser.add_argument("--runtime", default="180s")
    parser.add_argument("--deadline", default="600s")
    parser.add_argument("--min-soc", type=float, default=0.35)
    parser.add_argument("--max-temp", type=float, default=72.0)
    parser.add_argument("--connectivity", default="peer-group")
    parser.add_argument("--replicas", type=int, default=1)
    parser.add_argument("--failure-domain", default="orbital-plane")
    parser.add_argument("--node", default="sat002")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    state = root / ".oslurm-state"
    spec = {
        "oslurm_job_id": "oslurm-local-42",
        "runtime": args.runtime,
        "deadline": args.deadline,
        "min_soc": args.min_soc,
        "max_temp": args.max_temp,
        "connectivity": args.connectivity,
        "replicas": args.replicas,
        "failure_domain": args.failure_domain,
    }
    bridge = SlurmBridge(state)
    slurm_job_id, status = bridge.submit(args.node, Path(args.workload))
    JobStore(state / "oslurmd.sqlite").bind(slurm_job_id, spec["oslurm_job_id"], spec)
    print(json.dumps({"slurm_job_id": slurm_job_id, "status": status, "backend": bridge.status.backend}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

