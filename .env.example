# O-SLURM local environment template.
# Copy to .env or run: set -a; source .env; set +a

OSLURM_ROOT=/home/ngphpc/Desktop/OSLURM
OSLURM_STATE_DIR=/home/ngphpc/Desktop/OSLURM/.oslurm-state

# GMAT fixed local build used by the real provider backend.
GMAT_ROOT=/home/ngphpc/Desktop/OSLURM/third_party/GMAT-R2026a-fixed
GMAT_BIN=/home/ngphpc/Desktop/OSLURM/third_party/GMAT-R2026a-fixed/bin/GmatConsole

# Slurm local source/build tree and generated config.
SLURM_ROOT=/home/ngphpc/Desktop/OSLURM/third_party/slurm-26.05.3
SLURM_CONF=/home/ngphpc/Desktop/OSLURM/.oslurm-state/slurm/etc/slurm.conf

# Helpers for four local slurmd instances: sat001..sat004.
HOSTALIASES=/home/ngphpc/Desktop/OSLURM/.oslurm-state/slurm/etc/hostaliases
LD_PRELOAD=/home/ngphpc/Desktop/OSLURM/.oslurm-state/slurm/hosts_alias_preload.so
